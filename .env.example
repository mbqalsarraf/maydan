# Server-side secrets for Supabase Edge Functions. Names only; set values in
# Supabase Dashboard > Edge Functions > Secrets. Never commit real values or put them in web/.env.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
# Reserved for the future XE adapter (not implemented yet).
XE_API_KEY=
